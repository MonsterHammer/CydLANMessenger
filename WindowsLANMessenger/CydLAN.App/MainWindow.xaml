<Window
    x:Class="CydLAN.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="CydLAN Messenger">

    <Grid Background="{StaticResource AppBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="64" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border x:Name="AppTitleBar" Grid.Row="0" Background="#0A1422" BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="0,0,0,1" Padding="20,0,150,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="360" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Spacing="12">
                    <Border Width="36" Height="36" CornerRadius="6" Background="{StaticResource AppAccentBrush}">
                        <FontIcon Glyph="&#xE8BD;" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="CydLAN" FontSize="18" FontWeight="SemiBold" />
                        <TextBlock Text="LAN Messenger" FontSize="12" Foreground="{StaticResource MutedTextBrush}" />
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Spacing="10">
                    <Ellipse Width="10" Height="10" Fill="#31C96B" />
                    <StackPanel>
                        <TextBlock Text="Connected to LAN" FontSize="14" FontWeight="SemiBold" />
                        <TextBlock x:Name="ConnectionAddress" Text="Detecting adapter..." FontSize="12" Foreground="{StaticResource MutedTextBrush}" />
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="58" />
                <ColumnDefinition Width="330" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="330" />
            </Grid.ColumnDefinitions>

            <NavigationView Grid.Column="0" PaneDisplayMode="LeftMinimal" IsBackButtonVisible="Collapsed" IsSettingsVisible="False" Background="#0A1422" BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="0,0,1,0">
                <NavigationView.MenuItems>
                    <NavigationViewItem ToolTipService.ToolTip="Chats"><NavigationViewItem.Icon><SymbolIcon Symbol="Message" /></NavigationViewItem.Icon></NavigationViewItem>
                    <NavigationViewItem ToolTipService.ToolTip="Users"><NavigationViewItem.Icon><SymbolIcon Symbol="People" /></NavigationViewItem.Icon></NavigationViewItem>
                    <NavigationViewItem ToolTipService.ToolTip="Files"><NavigationViewItem.Icon><SymbolIcon Symbol="Folder" /></NavigationViewItem.Icon></NavigationViewItem>
                    <NavigationViewItem ToolTipService.ToolTip="History"><NavigationViewItem.Icon><SymbolIcon Symbol="Clock" /></NavigationViewItem.Icon></NavigationViewItem>
                    <NavigationViewItem ToolTipService.ToolTip="Settings"><NavigationViewItem.Icon><SymbolIcon Symbol="Setting" /></NavigationViewItem.Icon></NavigationViewItem>
                    <NavigationViewItem ToolTipService.ToolTip="About"><NavigationViewItem.Icon><SymbolIcon Symbol="Help" /></NavigationViewItem.Icon></NavigationViewItem>
                </NavigationView.MenuItems>
            </NavigationView>

            <Border Grid.Column="1" Background="#0A1422" BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="0,0,1,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="58" />
                    </Grid.RowDefinitions>

                    <AutoSuggestBox Grid.Row="0" Margin="16,16,16,10" PlaceholderText="Search users..." QueryIcon="Find" />
                    <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8" Margin="16,0,16,12">
                        <ToggleButton x:Name="AllFilter" Content="All (0)" IsChecked="True" CornerRadius="4" />
                        <ToggleButton x:Name="OnlineFilter" Content="Online (0)" CornerRadius="4" />
                        <ToggleButton Content="Offline (0)" CornerRadius="4" />
                    </StackPanel>
                    <TextBlock Grid.Row="2" Text="LAN USERS" FontSize="12" Foreground="{StaticResource MutedTextBrush}" Margin="16,0,16,10" />

                    <ListView Grid.Row="3" x:Name="UsersList" SelectionMode="Single" IsItemClickEnabled="True" ItemClick="UsersList_ItemClick" Background="Transparent">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid MinHeight="72" Margin="12,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="52" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Grid Grid.Column="0" Width="44" Height="44">
                                        <Ellipse Fill="#1A2940" />
                                        <TextBlock Text="{Binding Initials}" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="SemiBold" />
                                        <Ellipse Width="10" Height="10" Fill="{Binding StatusBrush}" HorizontalAlignment="Right" VerticalAlignment="Bottom" Stroke="#0A1422" StrokeThickness="2" />
                                    </Grid>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                        <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding Status}" FontSize="12" Foreground="{Binding StatusBrush}" />
                                        <TextBlock Text="{Binding Device}" FontSize="11" Foreground="{StaticResource MutedTextBrush}" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                    <Border Grid.Column="2" Background="{StaticResource AppAccentBrush}" CornerRadius="10" Padding="7,2" Visibility="{Binding UnreadVisibility}" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding UnreadCount}" FontSize="11" />
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <Border Grid.Row="4" BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="0,1,0,0">
                        <Grid Margin="16,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Spacing="8">
                                <Ellipse Width="8" Height="8" Fill="#31C96B" />
                                <TextBlock x:Name="OnlineCount" Text="0 online" FontSize="11" />
                            </StackPanel>
                            <TextBlock Grid.Column="1" Text="Protocol: LANNIES" VerticalAlignment="Center" FontSize="11" Foreground="{StaticResource MutedTextBrush}" />
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <Grid Grid.Column="2" Background="#08111D">
                <Grid.RowDefinitions><RowDefinition Height="72" /><RowDefinition Height="*" /><RowDefinition Height="74" /></Grid.RowDefinitions>

                <Border Grid.Row="0" BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="0,0,0,1">
                    <Grid Margin="20,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock x:Name="ChatName" Text="Select a LAN user" FontSize="20" FontWeight="SemiBold" />
                            <TextBlock x:Name="ChatStatus" Text="Discovery is starting" FontSize="13" Foreground="#31C96B" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <Button Content="&#xE717;" FontFamily="Segoe Fluent Icons" />
                            <Button Content="&#xE714;" FontFamily="Segoe Fluent Icons" />
                            <Button Content="&#xE712;" FontFamily="Segoe Fluent Icons" />
                        </StackPanel>
                    </Grid>
                </Border>

                <ScrollViewer Grid.Row="1" Padding="20">
                    <StackPanel Spacing="20">
                        <TextBlock Text="Messages will appear after the verified TCP handshake milestone." HorizontalAlignment="Center" Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" />
                    </StackPanel>
                </ScrollViewer>

                <Border Grid.Row="2" Margin="20,8,20,14" Background="#0F1B2B" BorderBrush="#26384F" BorderThickness="1" CornerRadius="5" Padding="8">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="44" /><ColumnDefinition Width="*" /><ColumnDefinition Width="44" /><ColumnDefinition Width="44" /></Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Content="&#xE710;" FontFamily="Segoe Fluent Icons" Background="Transparent" IsEnabled="False" />
                        <TextBox Grid.Column="1" PlaceholderText="Messaging unlocks after handshake support" BorderThickness="0" Background="Transparent" IsEnabled="False" />
                        <Button Grid.Column="2" Content="☺" Background="Transparent" IsEnabled="False" />
                        <Button Grid.Column="3" Content="&#xE724;" FontFamily="Segoe Fluent Icons" Background="{StaticResource AppAccentBrush}" CornerRadius="5" IsEnabled="False" />
                    </Grid>
                </Border>
            </Grid>

            <Border Grid.Column="3" Background="#0A1422" BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="1,0,0,0">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="58" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                    <TabView Grid.Row="0" IsAddTabButtonVisible="False" TabWidthMode="Equal">
                        <TabViewItem Header="Info" IsClosable="False" />
                        <TabViewItem Header="Files" IsClosable="False" />
                        <TabViewItem Header="History" IsClosable="False" />
                    </TabView>
                    <StackPanel Grid.Row="1" HorizontalAlignment="Center" Margin="0,20,0,18" Spacing="8">
                        <Ellipse Width="88" Height="88" Fill="#21334D" />
                        <TextBlock Text="Peer details" FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Center" />
                        <TextBlock Text="Awaiting user data exchange" Foreground="{StaticResource MutedTextBrush}" HorizontalAlignment="Center" />
                    </StackPanel>
                    <ScrollViewer Grid.Row="2">
                        <Border Padding="20,10">
                            <StackPanel Spacing="14">
                                <TextBlock Text="INFORMATION" FontSize="12" FontWeight="SemiBold" />
                                <TextBlock Text="Discovery provides the peer ID and IP address. Name, OS, status, capabilities, avatar, encryption and ping will populate after the upstream TCP handshake and userdata exchange are implemented." TextWrapping="Wrap" Foreground="{StaticResource MutedTextBrush}" />
                                <Separator Margin="0,8" />
                                <TextBlock Text="SHARED" FontSize="12" FontWeight="SemiBold" />
                                <TextBlock Text="Files and folders are not enabled yet." Foreground="{StaticResource MutedTextBrush}" />
                            </StackPanel>
                        </Border>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
